<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connect With Me</title>
  <!-- Tailwind CSS CDN for instant styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            heading: ['Outfit', 'sans-serif'],
            body: ['Plus Jakarta Sans', 'sans-serif'],
          },
          colors: {
            brand: {
              cream: '#FDFBF7',
              sand: '#F4EFEA',
              card: '#FFFFFF',
              terracotta: '#C86446',
              terracottaHover: '#B25438',
              slate: '#2B2D42',
              muted: '#717388'
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Smooth tap feedback on touch devices */
    .tap-effect {
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .tap-effect:active {
      transform: scale(0.97);
    }
  </style>
</head>
<body class="bg-brand-cream text-brand-slate font-body min-h-screen flex flex-col justify-between antialiased selection:bg-brand-terracotta selection:text-white">

  <!-- Background decorative accent glow -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-lg h-64 bg-brand-sand blur-3xl opacity-60 -z-10 pointer-events-none rounded-full"></div>

  <!-- Toast Notification Container for Share / Copy Feedback -->
  <div id="toast" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 opacity-0 pointer-events-none translate-y-[-10px]">
    <div class="bg-brand-slate text-white px-5 py-2.5 rounded-full shadow-lg text-sm font-medium flex items-center space-x-2">
      <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
      </svg>
      <span id="toast-message">Link copied to clipboard!</span>
    </div>
  </div>

  <!-- Main Card Container -->
  <main class="w-full max-w-md mx-auto px-5 pt-10 pb-8 flex-grow flex flex-col">
    
    <!-- Profile & Brand Header -->
    <header class="text-center mb-7">
      <!-- Profile Picture / Brand Logo Container -->
      <div class="relative inline-block mb-4">
        <div class="w-28 h-28 mx-auto rounded-full p-1 bg-gradient-to-tr from-brand-terracotta/40 via-brand-sand to-brand-terracotta shadow-md">
          <!-- 
            EDIT HERE: Change `src` to your photo or logo path (e.g. "avatar.jpg" if in your repo)
          -->
          <img 
            id="avatar"
            src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80" 
            alt="Profile Avatar" 
            class="w-full h-full object-cover rounded-full bg-white shadow-inner"
            onerror="this.src='https://placehold.co/200x200/F4EFEA/C86446?text=Profile'"
          />
        </div>
      </div>

      <!-- Names & Title -->
      <!-- EDIT HERE: Your Name or Business Name -->
      <h1 class="font-heading text-2xl font-bold tracking-tight text-brand-slate">
        Alex Morgan
      </h1>
      
      <!-- EDIT HERE: Your Job Title / Role -->
      <p class="text-brand-terracotta font-medium text-sm mt-0.5">
        Founder & Designer
      </p>

      <!-- EDIT HERE: Your Bio or Tagline -->
      <p class="text-brand-muted text-xs sm:text-sm mt-2 max-w-xs mx-auto leading-relaxed">
        Crafting modern goods and mindful spaces. Let's build something authentic together.
      </p>
    </header>

    <!-- Primary Action: Save Contact (Direct download to contact.vcf) -->
    <div class="mb-6">
      <!-- 
        Ensure you keep your 'contact.vcf' file in the root folder alongside this index.html on GitHub/Vercel.
      -->
      <a 
        href="contact.vcf" 
        download="contact.vcf"
        class="tap-effect w-full flex items-center justify-center space-x-2.5 bg-brand-terracotta hover:bg-brand-terracottaHover text-white py-3.5 px-6 rounded-2xl font-semibold shadow-md shadow-brand-terracotta/20 transition duration-150"
      >
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        <span class="tracking-wide">Save Contact to Phone</span>
      </a>
      <p class="text-[11px] text-center text-brand-muted mt-1.5">
        Instantly saves number, email, and profiles to address book
      </p>
    </div>

    <!-- Quick Links Stack -->
    <div class="space-y-3.5 flex-grow">
      
      <!-- 1. WEBSITE LINK -->
      <!-- EDIT HERE: Replace href with your actual website URL -->
      <a 
        href="https://yourwebsite.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="tap-effect group flex items-center p-3.5 bg-brand-card hover:bg-brand-sand/50 border border-stone-200/80 rounded-2xl shadow-sm hover:shadow transition duration-150"
      >
        <div class="w-11 h-11 flex-shrink-0 rounded-xl bg-orange-50 text-brand-terracotta flex items-center justify-center mr-3.5 group-hover:scale-105 transition-transform duration-150">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
          </svg>
        </div>
        <div class="flex-grow text-left">
          <span class="block text-sm font-semibold text-brand-slate">Official Website</span>
          <span class="block text-xs text-brand-muted truncate">Explore portfolio, shop, and updates</span>
        </div>
        <svg class="w-4 h-4 text-stone-400 group-hover:translate-x-0.5 transition-transform duration-150 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

      <!-- 2. INSTAGRAM LINK -->
      <!-- EDIT HERE: Replace href with your Instagram link -->
      <a 
        href="https://instagram.com/yourhandle" 
        target="_blank" 
        rel="noopener noreferrer"
        class="tap-effect group flex items-center p-3.5 bg-brand-card hover:bg-brand-sand/50 border border-stone-200/80 rounded-2xl shadow-sm hover:shadow transition duration-150"
      >
        <div class="w-11 h-11 flex-shrink-0 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center mr-3.5 group-hover:scale-105 transition-transform duration-150">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.13-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
        <div class="flex-grow text-left">
          <span class="block text-sm font-semibold text-brand-slate">Instagram</span>
          <!-- EDIT HERE: Your Instagram Handle -->
          <span class="block text-xs text-brand-muted">@yourhandle</span>
        </div>
        <svg class="w-4 h-4 text-stone-400 group-hover:translate-x-0.5 transition-transform duration-150 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

      <!-- 3. FACEBOOK LINK -->
      <!-- EDIT HERE: Replace href with your Facebook Page link -->
      <a 
        href="https://facebook.com/yourpage" 
        target="_blank" 
        rel="noopener noreferrer"
        class="tap-effect group flex items-center p-3.5 bg-brand-card hover:bg-brand-sand/50 border border-stone-200/80 rounded-2xl shadow-sm hover:shadow transition duration-150"
      >
        <div class="w-11 h-11 flex-shrink-0 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mr-3.5 group-hover:scale-105 transition-transform duration-150">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </div>
        <div class="flex-grow text-left">
          <span class="block text-sm font-semibold text-brand-slate">Facebook</span>
          <!-- EDIT HERE: Your Facebook page name / handle -->
          <span class="block text-xs text-brand-muted">Follow our community</span>
        </div>
        <svg class="w-4 h-4 text-stone-400 group-hover:translate-x-0.5 transition-transform duration-150 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

    </div>

    <!-- Quick Share Utility (Allows customer to copy link or share with someone else) -->
    <div class="mt-8 pt-4 border-t border-stone-200/60 flex justify-center">
      <button 
        type="button" 
        onclick="shareCard()" 
        class="tap-effect inline-flex items-center space-x-2 text-xs font-semibold text-brand-muted hover:text-brand-slate bg-stone-100 hover:bg-stone-200/80 px-4 py-2 rounded-full transition"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
        </svg>
        <span>Share or Copy Link</span>
      </button>
    </div>

    <!-- Minimal NFC Footer Note -->
    <footer class="mt-4 text-center">
      <p class="text-[11px] text-stone-400 font-medium flex items-center justify-center space-x-1">
        <span>Tap to connect</span>
        <span>•</span>
        <span>NFC Enabled</span>
      </p>
    </footer>

  </main>

  <script>
    // Show temporary toast message
    function showToast(message) {
      const toast = document.getElementById('toast');
      const toastMessage = document.getElementById('toast-message');
      
      toastMessage.textContent = message;
      toast.classList.remove('opacity-0', 'translate-y-[-10px]', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');

      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-[-10px]', 'pointer-events-none');
      }, 2500);
    }

    // Share API with fallback to copying current URL
    function shareCard() {
      const shareData = {
        title: document.title,
        text: 'Connect with Alex Morgan',
        url: window.location.href
      };

      if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
        navigator.share(shareData).catch(() => {});
      } else {
        // Fallback: Copy link
        const tempInput = document.createElement('input');
        tempInput.value = window.location.href;
        document.body.appendChild(tempInput);
        tempInput.select();
        try {
          document.execCommand('copy');
          showToast('Link copied to clipboard!');
        } catch (err) {
          showToast('Unable to copy link.');
        }
        document.body.removeChild(tempInput);
      }
    }
  </script>
</body>
</html>
